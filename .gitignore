# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
tmp
out-tsc
*.tsbuildinfo
.expo
.expo-shared

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings
*.log

# Environment files (never commit secrets)
.env
.env.*
!.env.example
# .env.production holds only PUBLIC client-side build vars (VITE_*) that
# are baked into the static bundle anyway. Safe to commit.
!.env.production
key.json

# System Files
.DS_Store
Thumbs.db

.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md

# dev-only caches
.cache/
.local/

# Playwright run artifacts
playwright-report/
test-results/
blob-report/

# Local git worktrees used for isolated agent work
.claude/worktrees/

# Stitch evidence — regenerable, and heavy (17 MB of PNGs when committed).
# tools/record-stitch-evidence.mjs recreates this directory on demand:
#   E2E_FULL_STACK=1 pnpm run test:stitch-runtime
# Traces under it were already gitignored; the screenshots now match, so the
# evidence trail stays reproducible without carrying binaries in git.
artifacts/audit/
