# ── API ───────────────────────────────────────────────────────────────────────
# Full URL of the backend API (no trailing slash).
# Production Cloud Run service:
VITE_API_BASE=https://wellness-foods-475157072474.asia-south2.run.app/api
# Local dev (run api-server on 4000):
# VITE_API_BASE=http://localhost:4000/api

# ── Razorpay ──────────────────────────────────────────────────────────────────
# Public key only — never put the secret here.
VITE_RAZORPAY_KEY_ID=rzp_live_XXXXXXXXXXXXXXXX

# ── Feature flags ─────────────────────────────────────────────────────────────
# Set to "1" to enable experimental features in development.
# VITE_ENABLE_EXPERIMENTAL=0

# ── Google Maps ───────────────────────────────────────────────────────────────
VITE_GOOGLE_MAPS_API_KEY=

# ── Firebase ──────────────────────────────────────────────────────────────────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
