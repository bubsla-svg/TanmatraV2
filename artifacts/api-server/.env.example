# ── Database ──────────────────────────────────────────────────────────────────
# Cloud SQL socket (production):
DATABASE_URL=postgresql://postgres:PASSWORD@/neondb?host=/cloudsql/PROJECT:REGION:INSTANCE
# Local dev via proxy (port 9470):
# DATABASE_URL=postgresql://postgres:PASSWORD@localhost:9470/neondb

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=8080

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
ALLOWED_ORIGINS=https://tanmatra.food,https://www.tanmatra.food

# ── Admin auth ────────────────────────────────────────────────────────────────
# Generate with: POST /admin/_hash { "password": "yourpassword" } (provide
# x-admin-secret header = ADMIN_SESSION_SECRET).
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=scrypt$16384$8$1$SALT_HEX$HASH_HEX
# Must be ≥ 32 characters.
ADMIN_SESSION_SECRET=CHANGE_ME_32_CHARS_MINIMUM_RANDOM_STRING

# ── Consumer auth ─────────────────────────────────────────────────────────────
# Cookie security — set to "1" only in local dev over HTTP.
INSECURE_DEV_COOKIE=0
SESSION_SAMESITE=lax

# ── Payments — Razorpay ───────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_live_XXXXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_SECRET
# From Razorpay Dashboard → Webhooks → Secret
RAZORPAY_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET

# ── SMS / OTP — MSG91 ─────────────────────────────────────────────────────────
MSG91_AUTH_KEY=
MSG91_SENDER_ID=TANMTR
MSG91_TEMPLATE_ID=

# ── Truecaller 1-Tap sign-in (OAuth 2.0 + PKCE) ───────────────────────────────
# POST /auth/truecaller/verify exchanges the mobile app's authorization code
# with Truecaller and derives the VERIFIED phone from Truecaller's userinfo
# (never from the client). REQUIRED in production — without TRUECALLER_CLIENT_ID
# the endpoint returns 503 (fails closed). In non-production with no client id,
# it runs in mock mode (accepts a dev-supplied devPhoneE164) for local/CI.
TRUECALLER_CLIENT_ID=
# Optional — override the region-specific OAuth hosts (default: non-EU / India).
# TRUECALLER_TOKEN_URL=https://oauth-account-noneu.truecaller.com/v1/token
# TRUECALLER_USERINFO_URL=https://oauth-account-noneu.truecaller.com/v1/userinfo
# Set only if the authorize step uses a redirect_uri (RFC 6749 §4.1.3).
# TRUECALLER_REDIRECT_URI=

# ── Clinical data encryption (DPDPA) — KMS master key ─────────────────────────
# AES-256-GCM master key for envelope-encrypting subscription-member clinical
# free-text at rest (medicalConditions / allergens / dislikedIngredients).
# REQUIRED in production — the server refuses to boot without it (see
# validateEnv). Provide 64 hex chars (32 bytes). Generate with:
#   openssl rand -hex 32
# Aliases also accepted: MASTER_KEY, DPDPA_MASTER_KEY_HEX, CLINICAL_MASTER_KEY_HEX.
CLINICAL_KMS_MASTER_KEY=

# ── AI — Google Gemini ────────────────────────────────────────────────────────
GOOGLE_API_KEY=AIzaSy...

# ── POS integration — Petpooja ────────────────────────────────────────────────
# All four required vars must be set to activate the integration.
#
# The inbound webhook surface FAILS CLOSED. When these are unset the routes are
# not mounted at all, and any request that did reach them would be rejected —
# there is no secret to authenticate against, so there is no legitimate caller.
# (Before 25 Jul 2026 the opposite was true: unset credentials meant inbound
# auth was skipped, which left /push-menu — a bulk write to menu_items including
# price_paise — reachable by anyone. Do not reintroduce that.)
#
# When set, every inbound webhook is authenticated by app_key+app_secret in the
# body or the x-petpooja-app-secret header, and paid orders are pushed to the POS.
PETPOOJA_APP_KEY=
PETPOOJA_APP_SECRET=
PETPOOJA_ACCESS_TOKEN=
PETPOOJA_RESTAURANT_ID=
PETPOOJA_RESTAURANT_NAME=Wellness Foods
# Petpooja Save Order endpoint (outbound). Default is the standard POS URL.
PETPOOJA_SAVE_ORDER_URL=https://pos.petpooja.com/api/v1/save_order
# Menu sharing code (defaults to PETPOOJA_RESTAURANT_ID when unset).
PETPOOJA_MENU_SHARING_CODE=
#
# Kill switch. Set to false/0/off/no to UNMOUNT the inbound webhook routes —
# they 404 instead of existing. This is how you decommission the integration;
# do NOT do it by blanking the credentials above. Unset or true = mounted
# (provided the four vars above are all set).
PETPOOJA_WEBHOOKS_ENABLED=
#
# Local development ONLY. Mounts the webhook surface with authentication
# bypassed so you can POST fixtures at it without credentials. Refused outright
# when NODE_ENV=production. Never set this on a deployed service.
PETPOOJA_WEBHOOKS_INSECURE_ALLOW_UNAUTHENTICATED=

# ── Petpooja INVENTORY API (separate host, separate identifier) ───────────────
# NOT the same service as the POS integration above, and NOT interchangeable
# with it. Ordering/menu uses the menu sharing code against pos.petpooja.com;
# inventory uses the numeric RID against inventory.petpooja.com. The three
# credentials are shared between the two.
#
# Both syncs stay completely inert (no timer is even registered) until
# PETPOOJA_INVENTORY_RID and the three PETPOOJA_* credentials above are set.
PETPOOJA_INVENTORY_RID=
PETPOOJA_INVENTORY_BASE_URL=https://inventory.petpooja.com
# Endpoint paths are overridable because the vendor's Inventory API reference is
# client-rendered and could not be read — see the ⚠ block in petpoojaInventory.ts.
PETPOOJA_PURCHASE_PATH=/api/get_purchase
PETPOOJA_STOCK_PATH=/api/get_stock
#
# Purchases → ingredient prices (inventory_items.buying_price_paise). Daily.
PETPOOJA_PURCHASE_SYNC_DISABLED=
PETPOOJA_PURCHASE_SYNC_DRY_RUN=
PETPOOJA_PURCHASE_SYNC_INTERVAL_MS=
PETPOOJA_PURCHASE_SYNC_LOOKBACK_DAYS=
#
# Stock → on-hand quantities (kitchen_stock.on_hand_qty). Every 6h.
PETPOOJA_STOCK_SYNC_DISABLED=
PETPOOJA_STOCK_SYNC_DRY_RUN=
PETPOOJA_STOCK_SYNC_INTERVAL_MS=
#
# Both DRY_RUN flags ship set to 1 in production (see deploy.yml) — arming the
# syncs and letting them write are deliberately two separate decisions. A dry run
# fetches and matches exactly as a live one does, then logs the whole plan at
# WARN under `planned` (capped at 100 entries, with `plannedTotal` carrying the
# real count) instead of writing. Read those numbers against what the outlet
# actually holds and paid, then remove the flag — purchases first, stock second.

# ── Wearables — Terra/Vital aggregator ────────────────────────────────────────
# Provider-agnostic activity-metrics ingestion (steps, active energy, resting
# HR, sleep). The app is a web SPA, so we use a CLOUD AGGREGATOR that delivers
# data server-side by webhook — no native/device code.
#
# The integration stays OFF (inert) until the minimum set is present:
#   WEARABLE_PROVIDER  +  an API key  +  a signing secret.
# When unset, POST /integrations/wearable/webhook is a 200 no-op and
# /wearable/connect keeps the existing "web preview" stub behavior.
#
# WEARABLE_PROVIDER: terra | vital | mock  ("mock" = shared-secret header auth
# for local/dev/test; terra/vital = HMAC-SHA256 signature verification).
WEARABLE_PROVIDER=
# Terra-specific (preferred names):
TERRA_DEV_ID=
TERRA_API_KEY=
# Signing secret Terra uses for the `terra-signature: t=…,v1=…` webhook header.
TERRA_SIGNING_SECRET=
# Generic fallbacks (used if the TERRA_* names are unset — e.g. for Vital):
WEARABLE_API_KEY=
WEARABLE_SIGNING_SECRET=

# ── Cloud SQL ─────────────────────────────────────────────────────────────────
CLOUD_SQL_INSTANCE=project:region:instance

# ── RD admin token (legacy — prefer signed admin cookie) ──────────────────────
RD_ADMIN_TOKEN=

# ── Optional: ops override bulkhead DB (defaults to DATABASE_URL if unset) ───
# OVERRIDE_DATABASE_URL=
