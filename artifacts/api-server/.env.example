# ── Database ──────────────────────────────────────────────────────────────────
# Cloud SQL socket (production):
DATABASE_URL=postgresql://postgres:PASSWORD@/neondb?host=/cloudsql/PROJECT:REGION:INSTANCE
# Local dev via proxy (port 9470):
# DATABASE_URL=postgresql://postgres:PASSWORD@localhost:9470/neondb

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=8080

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
ALLOWED_ORIGINS=https://tanmatra.food,https://www.tanmatra.food

# ── Admin auth ────────────────────────────────────────────────────────────────
# Generate with: POST /admin/_hash { "password": "yourpassword" } (provide
# x-admin-secret header = ADMIN_SESSION_SECRET).
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=scrypt$16384$8$1$SALT_HEX$HASH_HEX
# Must be ≥ 32 characters.
ADMIN_SESSION_SECRET=CHANGE_ME_32_CHARS_MINIMUM_RANDOM_STRING

# ── Consumer auth ─────────────────────────────────────────────────────────────
# Cookie security — set to "1" only in local dev over HTTP.
INSECURE_DEV_COOKIE=0
SESSION_SAMESITE=lax

# ── Payments — Razorpay ───────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_live_XXXXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_SECRET
# From Razorpay Dashboard → Webhooks → Secret
RAZORPAY_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET

# ── SMS / OTP — MSG91 ─────────────────────────────────────────────────────────
MSG91_AUTH_KEY=
MSG91_SENDER_ID=TANMTR
MSG91_TEMPLATE_ID=

# ── Clinical data encryption (DPDPA) — KMS master key ─────────────────────────
# AES-256-GCM master key for envelope-encrypting subscription-member clinical
# free-text at rest (medicalConditions / allergens / dislikedIngredients).
# REQUIRED in production — the server refuses to boot without it (see
# validateEnv). Provide 64 hex chars (32 bytes). Generate with:
#   openssl rand -hex 32
# Aliases also accepted: MASTER_KEY, DPDPA_MASTER_KEY_HEX, CLINICAL_MASTER_KEY_HEX.
CLINICAL_KMS_MASTER_KEY=

# ── AI — Google Gemini ────────────────────────────────────────────────────────
GOOGLE_API_KEY=AIzaSy...

# ── POS integration — Petpooja ────────────────────────────────────────────────
# All four required vars must be set to activate the integration. When unset,
# the Petpooja routes stay mounted but outbound order-push is a no-op and
# inbound webhook auth logs a warning + allows (so dev/test isn't broken).
# When set, credential-bearing inbound webhooks (saveorder/orderstatus/
# rider-info) are authenticated and paid orders are pushed to the POS.
PETPOOJA_APP_KEY=
PETPOOJA_APP_SECRET=
PETPOOJA_ACCESS_TOKEN=
PETPOOJA_RESTAURANT_ID=
PETPOOJA_RESTAURANT_NAME=Wellness Foods
# Petpooja Save Order endpoint (outbound). Default is the standard POS URL.
PETPOOJA_SAVE_ORDER_URL=https://pos.petpooja.com/api/v1/save_order
# Menu sharing code (defaults to PETPOOJA_RESTAURANT_ID when unset).
PETPOOJA_MENU_SHARING_CODE=

# ── Wearables — Terra/Vital aggregator ────────────────────────────────────────
# Provider-agnostic activity-metrics ingestion (steps, active energy, resting
# HR, sleep). The app is a web SPA, so we use a CLOUD AGGREGATOR that delivers
# data server-side by webhook — no native/device code.
#
# The integration stays OFF (inert) until the minimum set is present:
#   WEARABLE_PROVIDER  +  an API key  +  a signing secret.
# When unset, POST /integrations/wearable/webhook is a 200 no-op and
# /wearable/connect keeps the existing "web preview" stub behavior.
#
# WEARABLE_PROVIDER: terra | vital | mock  ("mock" = shared-secret header auth
# for local/dev/test; terra/vital = HMAC-SHA256 signature verification).
WEARABLE_PROVIDER=
# Terra-specific (preferred names):
TERRA_DEV_ID=
TERRA_API_KEY=
# Signing secret Terra uses for the `terra-signature: t=…,v1=…` webhook header.
TERRA_SIGNING_SECRET=
# Generic fallbacks (used if the TERRA_* names are unset — e.g. for Vital):
WEARABLE_API_KEY=
WEARABLE_SIGNING_SECRET=

# ── Cloud SQL ─────────────────────────────────────────────────────────────────
CLOUD_SQL_INSTANCE=project:region:instance

# ── RD admin token (legacy — prefer signed admin cookie) ──────────────────────
RD_ADMIN_TOKEN=

# ── Optional: ops override bulkhead DB (defaults to DATABASE_URL if unset) ───
# OVERRIDE_DATABASE_URL=
