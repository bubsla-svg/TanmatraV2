# ── How this file is loaded ───────────────────────────────────────────────────
# Copy to `.env.local` (gitignored) and fill in. Next reads .env.local for
# `next dev`, `next build` and `next start`.
#
# THREE OF THESE ARE BAKED IN AT BUILD TIME and cannot be changed by restarting:
#   • NEXT_PUBLIC_*   — inlined into the client bundle by `next build`
#   • API_UPSTREAM    — compiled into routes-manifest.json by `next build`
#   • IMAGE_UPSTREAM  — same
# Setting them at `next start` does nothing (verified empirically). Repointing
# either upstream means a rebuild, not a restart. deploy.yml passes all of them
# as Docker build args for exactly this reason.

# ── API wiring ────────────────────────────────────────────────────────────────
# LEAVE EMPTY. The browser then calls same-origin /api/*, which the rewrite
# proxies, so the session cookie stays first-party. A cross-site storefront→api
# topology drops that cookie under Safari/ITP — this empty value is the fix, not
# an oversight. The deployed image ships it empty too.
NEXT_PUBLIC_API_BASE=

# Where SERVER components fetch the API directly, bypassing the rewrite.
API_BASE_URL=http://localhost:8080

# Build-time. Target of the same-origin /api/* rewrite.
API_UPSTREAM=http://localhost:8080

# Build-time. Dish photography (~280 base JPGs, ~196 MB) lives in the legacy
# app's public/ dir, not in this package, so /images/* is proxied out. Blanking
# it makes every dish photo 404.
IMAGE_UPSTREAM=https://tanmatra-475157072474.asia-south2.run.app

# ── Canonical origin ──────────────────────────────────────────────────────────
# metadataBase, sitemap.ts, robots.ts, every JSON-LD url/@id (lib/siteUrl.ts).
# Production passes https://tanmatra.food.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Feature flags (build-time, client-readable) ───────────────────────────────
# Live checkout needs ALL of: api-server reachable (CORS + SESSION_SAMESITE=none),
# FLAG_PLAN_V2=1, the Firebase config below, and real RAZORPAY_* keys server-side.
# 1 without all four yields a checkout that fails at the OTP step.
NEXT_PUBLIC_LIVE_CHECKOUT=0
# Meal-card rail (Pluxee / Sodexo) — off until merchant onboarding completes.
NEXT_PUBLIC_MEALCARD_RAIL=0

# ── Firebase phone-auth ───────────────────────────────────────────────────────
# Public by design: this config ships in the client bundle, and the security
# boundary is the server verifying the resulting idToken. Source: Firebase
# console → Project settings → Your apps → SDK setup and config.
# All blank = firebaseConfigured() is false and the auth islands stay stubbed,
# which is a working default for everything except live checkout.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Observability (all optional; blank = inert) ───────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=
# Source-map upload on release builds only.
SENTRY_ORG=
SENTRY_PROJECT=
NEXT_PUBLIC_ANALYTICS_BEACON=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# ── Test / CI only ────────────────────────────────────────────────────────────
# Playwright target — a local prod build or the deployed service; same specs.
E2E_BASE_URL=http://localhost:3000
# Sandboxes ship Chromium at a fixed path instead of Playwright's download.
E2E_CHROMIUM_PATH=/opt/pw-browsers/chromium
# 1 = run specs that need a real api-server + DB behind the storefront.
E2E_FULL_STACK=0
# 1 = let checkout specs hit the live money path.
E2E_LIVE_CHECKOUT=0
E2E_SEEDED_ORDER_ID=
# 1 = run the frontend defect audit (tap targets, occlusion, image collapse).
RUN_FRONTEND_AUDIT=0
# 1 = REWRITE the visual-regression baselines instead of comparing against them.
VRT_UPDATE_BASELINES=0
